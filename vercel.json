{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "rewrites": [
    {
      "source": "/api/auth/:action",
      "destination": "/api/auth?action=:action"
    },
    {
      "source": "/api/friends/:action",
      "destination": "/api/friends?action=:action"
    },
    {
      "source": "/api/groups/:action",
      "destination": "/api/groups?action=:action"
    }
  ]
}
